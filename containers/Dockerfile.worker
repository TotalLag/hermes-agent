# =============================================================================
# hermes-agent HiClaw Worker
# =============================================================================
# Worker container — runs hermes-agent with hiclaw-worker skill.
# Communicates with the Manager via Matrix DMs and MinIO for task specs/results.
#
# Required env vars:
#   HICLAW_MANAGER_ROOM_ID    Matrix room ID for the Manager (worker joins this room)
#   HICLAW_WORKER_NAME        Unique worker name (e.g. worker-copilot-01)
#   HICLAW_WORKER_VERSION     Worker version string
#   MATRIX_HOMESERVER         Matrix homeserver URL (e.g. https://matrix.example.org)
#   MATRIX_ACCESS_TOKEN       Matrix access token for this worker bot
#   HICLAW_LLM_API_KEY       LLM API key
#   HICLAW_LLM_PROVIDER       LLM provider (e.g. openai-compat)
#   HICLAW_OPENAI_BASE_URL   OpenAI-compatible base URL
#   HICLAW_DEFAULT_MODEL      Default model name
#   HICLAW_MINIO_ENDPOINT    MinIO endpoint (e.g. minio:9000)
#   HICLAW_MINIO_ACCESS_KEY  MinIO access key
#   HICLAW_MINIO_SECRET_KEY  MinIO secret key
#   HICLAW_MINIO_BUCKET      MinIO bucket for task specs/results
#   HICLAW_REGISTRATION_TOKEN Registration token (must match Manager's token)
#   HICLAW_MANAGER_MXID      Manager's Matrix user ID (for DM registration)
#   DOCKER_HOST              Docker socket (e.g. unix:///var/run/docker.sock)
#
# Build:
#   docker build -f containers/Dockerfile.worker -t hermes-worker:latest .
# =============================================================================

FROM python:3.11-slim

WORKDIR /app

# Install system deps for hermes-agent and docker operations
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    ca-certificates \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Install uv for fast package management
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"

# Create venv
RUN uv venv /opt/hermes-env --python 3.11
ENV VIRTUAL_ENV=/opt/hermes-env
ENV PATH="/opt/hermes-env/bin:$PATH"

# Install hermes-agent core + messaging + MCP + MinIO + docker-py
COPY pyproject.toml /tmp/
RUN uv pip install --no-cache-dir \
    ".[messaging,mcp]" \
    minio \
    docker

# Install hermes-agent from local source (editable)
COPY . /app
RUN uv pip install --no-cache-dir -e /app

# Create hermes home directory
RUN mkdir -p /root/.hermes

# Health check: worker should respond to Matrix DMs
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health', timeout=5)" || exit 1

# Run hermes-agent as worker
CMD ["hermes", "agent", \
     "--model", "${HICLAW_LLM_PROVIDER}:${HICLAW_DEFAULT_MODEL}", \
     "--platform", "matrix", \
     "--skills", "hiclaw/worker-lifecycle"]
