# =============================================================================
# HiClaw Production Secrets
# =============================================================================
# Copy this file from hiclaw-secrets.env.example and fill in actual values.
# For Swarm mode, use docker/hiclaw-secrets.docker-compose.yml instead.
# This file is used via: --env-file docker/hiclaw-secrets.env
# =============================================================================

# ---------------------------------------------------------------------------
# Matrix Accounts (required)
# ---------------------------------------------------------------------------
# Manager Matrix account credentials (register via Synapse admin)
HICLAW_MANAGER_MXID=@hiclaw_manager:hermes.local
HICLAW_MANAGER_PASSWORD=YOUR_MANAGER_MATRIX_PASSWORD_HERE

# Worker Matrix account credentials (register via Synapse admin)
HICLAW_WORKER1_ACCESS_TOKEN=YOUR_WORKER_MATRIX_ACCESS_TOKEN_HERE

# Admin user for worker registration approval
HICLAW_ADMIN_MXID=@admin:hermes.local
HICLAW_ADMIN_PASSWORD=YOUR_ADMIN_MATRIX_PASSWORD_HERE

# ---------------------------------------------------------------------------
# LLM Configuration (required)
# ---------------------------------------------------------------------------
HICLAW_LLM_API_KEY=YOUR_LLM_API_KEY_HERE
HICLAW_LLM_PROVIDER=openai-compat
HICLAW_OPENAI_BASE_URL=https://api.openai.com/v1
HICLAW_DEFAULT_MODEL=gpt-4o

# ---------------------------------------------------------------------------
# MinIO Object Storage (optional - defaults shown)
# ---------------------------------------------------------------------------
HICLAW_MINIO_ACCESS_KEY=YOUR_MINIO_ACCESS_KEY_HERE
HICLAW_MINIO_SECRET_KEY=YOUR_MINIO_SECRET_KEY_HERE
HICLAW_MINIO_BUCKET=hiclaw

# ---------------------------------------------------------------------------
# Synapse Configuration (optional - defaults shown)
# ---------------------------------------------------------------------------
SYNAPSE_SERVER_NAME=hermes.local
SYNAPSE_REGISTRATION_SHARED_SECRET=YOUR_SYNAPSE_REGISTRATION_SECRET_HERE

# ---------------------------------------------------------------------------
# Worker Configuration (optional - defaults shown)
# ---------------------------------------------------------------------------
HICLAW_REGISTRATION_TOKEN=changeme
HICLAW_WORKER_HEARTBEAT_INTERVAL=120
HICLAW_MANAGER_CHECK_INTERVAL=300
HICLAW_STALE_THRESHOLD_SECONDS=300
