# =============================================================================
# HiClaw Production Secrets - Docker Swarm Mode
# =============================================================================
# This file documents all secrets required for Docker Swarm mode deployment.
#
# IMPORTANT:
#   - This is a REFERENCE FILE showing required secrets
#   - For Docker Swarm, use: docker/hiclaw-secrets.docker-compose.yml
#   - For non-swarm, use: docker/hiclaw-secrets.env (env_file approach)
#   - NEVER commit actual secret values to version control
#
# HOW TO CREATE SECRETS (Docker Swarm):
#   # Option 1: From command line
#   echo -n "your-secret-value" | docker secret create hiclaw_matrix_access_token -
#
#   # Option 2: Using the create-secrets.sh script
#   ./docker/create-secrets.sh /path/to/secrets/directory/
#
# HOW SECRETS APPEAR TO CONTAINERS:
#   Secrets are mounted as files at: /run/secrets/<secret_name>
#   Example: /run/secrets/hiclaw_matrix_access_token
#
# =============================================================================
# SECRETS LIST
# =============================================================================
# Format: SECRET_NAME=example_value  # REQUIRED/OPTIONAL - Description
# =============================================================================

# -----------------------------------------------------------------------------
# Matrix Credentials (REQUIRED)
# -----------------------------------------------------------------------------
# Matrix access token for hermes-manager
# Generate via: curl -X POST -d '{"type":"m.login.password","identifier":{"type":"m.id.user","user":"@manager:your-server"},"password":"your-password"}' http://localhost:8008/_matrix/client/r0/login
HICLAW_MATRIX_ACCESS_TOKEN=YOUR_MATRIX_ACCESS_TOKEN_HERE  # REQUIRED - Replace with actual token

# Matrix user ID (MXID) for hermes-manager
HICLAW_MATRIX_USER_ID=@hermes-manager:your-server  # REQUIRED

# Matrix homeserver URL
HICLAW_MATRIX_HOMESERVER_URL=http://synapse:8008  # REQUIRED

# -----------------------------------------------------------------------------
# MinIO Credentials (REQUIRED)
# -----------------------------------------------------------------------------
# MinIO access key for object storage
HICLAW_MINIO_ACCESS_KEY=YOUR_MINIO_ACCESS_KEY_HERE  # REQUIRED

# MinIO secret key for object storage
HICLAW_MINIO_SECRET_KEY=YOUR_MINIO_SECRET_KEY_HERE  # REQUIRED

# -----------------------------------------------------------------------------
# Legacy Secrets (for env_file backward compatibility - OPTIONAL)
# -----------------------------------------------------------------------------
# These are used when NOT using Docker Swarm (env_file approach)

# LLM API Key (OpenAI, OpenRouter, etc.)
HICLAW_LLM_API_KEY=your_llm_api_key_here  # REQUIRED (env_file mode)

# Matrix access token for hermes-manager (env_file mode)
HICLAW_MANAGER_ACCESS_TOKEN=  # REQUIRED (env_file mode)

# Matrix access token for hermes-worker-1 (env_file mode)
HICLAW_WORKER1_ACCESS_TOKEN=  # REQUIRED (env_file mode)

# Matrix access token for admin user (env_file mode)
MATRIX_ACCESS_TOKEN=  # OPTIONAL (env_file mode)
