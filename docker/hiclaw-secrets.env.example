# =============================================================================
# HiClaw Production Secrets
# =============================================================================
# Copy this file to hiclaw-secrets.env and fill in actual values.
# NEVER commit hiclaw-secrets.env to version control.
#
# Required secrets for production:
# =============================================================================

# LLM API Key (OpenAI, OpenRouter, etc.)
HICLAW_LLM_API_KEY=

# Matrix access token for hermes-manager
# Generate via: curl -X POST -d '{"type":"m.login.password","identifier":{"type":"m.id.user","user":"@manager:your-server"},"password":"your-password"}' http://localhost:8008/_matrix/client/r0/login
HICLAW_MANAGER_ACCESS_TOKEN=

# Matrix access token for hermes-worker-1
# Generate via: curl -X POST -d '{"type":"m.login.password","identifier":{"type":"m.id.user","user":"@worker1:your-server"},"password":"your-password"}' http://localhost:8008/_matrix/client/r0/login
HICLAW_WORKER1_ACCESS_TOKEN=

# Matrix access token for admin user (optional, for bot commands)
MATRIX_ACCESS_TOKEN=
