# =============================================================================
# HiClaw Docker Environment Variables
# =============================================================================
# Copy to hiclaw.env and fill in your values.
# DO NOT commit hiclaw.env with real secrets!
# For production, use docker-compose.prod.yml with secrets management.
# =============================================================================

# =============================================================================
# SECTION 1: Infrastructure (Synapse + MinIO)
# =============================================================================
SYNAPSE_SERVER_NAME=hermes.local
SYNAPSE_REGISTRATION_SHARED_SECRET=change_me_to_random_secret
HICLAW_MINIO_ACCESS_KEY=hiclawadmin
HICLAW_MINIO_SECRET_KEY=hiclawsecretpass
HICLAW_MINIO_BUCKET=hiclaw

# =============================================================================
# SECTION 2: LLM Provider
# =============================================================================
HICLAW_LLM_API_KEY=your_api_key_here
HICLAW_LLM_PROVIDER=openai-compat
HICLAW_OPENAI_BASE_URL=https://api.openai.com/v1
HICLAW_DEFAULT_MODEL=gpt-4o

# =============================================================================
# SECTION 3: Worker Management
# =============================================================================
HICLAW_REGISTRATION_TOKEN=change_me_to_random_token
HICLAW_WORKER_COUNT=1
HICLAW_WORKER_HEARTBEAT_INTERVAL=120
HICLAW_MANAGER_CHECK_INTERVAL=300
HICLAW_STALE_THRESHOLD_SECONDS=300

# =============================================================================
# SECTION 4: Matrix Users (registered by bootstrap-matrix-users.py)
# =============================================================================
# Run: python docker/bootstrap-matrix-users.py
# Manager
HICLAW_MANAGER_MXID=@hermes-manager:hermes.local
HICLAW_MANAGER_PASSWORD=manager_password_here
HICLAW_MANAGER_ACCESS_TOKEN=  # Filled by bootstrap script

# Workers (one per HICLAW_WORKER_COUNT)
HICLAW_WORKER1_MXID=@hermes-worker-1:hermes.local
HICLAW_WORKER1_PASSWORD=worker1_password_here
HICLAW_WORKER1_ACCESS_TOKEN=  # Filled by bootstrap script

HICLAW_WORKER2_MXID=@hermes-worker-2:hermes.local
HICLAW_WORKER2_PASSWORD=worker2_password_here
HICLAW_WORKER2_ACCESS_TOKEN=  # Filled by bootstrap script

HICLAW_WORKER3_MXID=@hermes-worker-3:hermes.local
HICLAW_WORKER3_PASSWORD=worker3_password_here
HICLAW_WORKER3_ACCESS_TOKEN=  # Filled by bootstrap script

# Admin
HICLAW_ADMIN_MXID=@admin:hermes.local
HICLAW_ADMIN_PASSWORD=admin_password_here

# =============================================================================
# SECTION 5: Resource Limits (optional, enforced by docker-compose)
# =============================================================================
HERMES_MEMORY_LIMIT=1g
HERMES_CPU_LIMIT=1.0
HICLAW_VERSION=1.0.0

# =============================================================================
# SECTION 6: Production Secrets (docker-compose.prod.yml env_file)
# =============================================================================
# For production, mount these via docker secrets or env_file:
# HICLAW_LLM_API_KEY=  (required)
# HICLAW_MANAGER_ACCESS_TOKEN=  (required after bootstrap)
# HICLAW_WORKER1_ACCESS_TOKEN=  (required after bootstrap)
# HICLAW_WORKER2_ACCESS_TOKEN=  (required after bootstrap)
# HICLAW_WORKER3_ACCESS_TOKEN=  (required after bootstrap)
