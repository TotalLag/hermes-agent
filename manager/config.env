# =============================================================================
# hermes-agent hiclaw Manager — Required Environment Variables
# =============================================================================
# These env vars must be set for the Manager container to operate.
# They are typically injected by the hiclaw install script or docker-compose.
# =============================================================================

# --- Matrix ---
HICLAW_MATRIX_DOMAIN=matrix-local.hiclaw.io:18080
HICLAW_MATRIX_E2EE=0

# --- AI Gateway ---
HICLAW_AI_GATEWAY_DOMAIN=aigw-local.hiclaw.io
HICLAW_LLM_API_KEY=sk-cp-...
HICLAW_LLM_PROVIDER=openai-compat
HICLAW_OPENAI_BASE_URL=https://api.minimax.io/v1
HICLAW_DEFAULT_MODEL=MiniMax-M2.7
HICLAW_SKILLS_API_URL=

# --- Manager Auth ---
HICLAW_MANAGER_GATEWAY_KEY=    # Auto-generated if not set
HICLAW_MANAGER_PASSWORD=       # Auto-generated if not set
HICLAW_ADMIN_USER=root
HICLAW_ADMIN_PASSWORD=Welcome123!

# --- Storage ---
HICLAW_MINIO_USER=root
HICLAW_MINIO_PASSWORD=Welcome123!
HICLAW_DATA_DIR=hiclaw-data
HICLAW_WORKSPACE_DIR=/root/manager-workspace

# --- Container ---
HICLAW_CONTAINER_API=http://hiclaw-docker-proxy:2375
HICLAW_DOCKER_PROXY=1
HICLAW_DEFAULT_WORKER_RUNTIME=copaw
HICLAW_WORKER_IDLE_TIMEOUT=720

# --- Workers ---
HICLAW_REGISTRATION_TOKEN=

# --- MinIO Sync (hermes-agent) ---
HICLAW_MC_HOST=myminio
HICLAW_BUCKET=hiclaw
HICLAW_ACCESS_KEY=root
HICLAW_SECRET_KEY=Welcome123!
HICLAW_TASK_SPECS_PREFIX=task-specs/
HICLAW_TASK_RESULTS_PREFIX=task-results/
